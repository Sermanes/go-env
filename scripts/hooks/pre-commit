#!/usr/bin/env bash
# pre-commit – runs on every `git commit`
# Checks: gofmt diff · go vet · golangci-lint (staged packages only)
set -euo pipefail

YELLOW='\033[1;33m'
RED='\033[0;31m'
GREEN='\033[0;32m'
RESET='\033[0m'

step() { echo -e "${YELLOW}[pre-commit]${RESET} $*"; }
ok()   { echo -e "${GREEN}[pre-commit] ✓${RESET} $*"; }
fail() { echo -e "${RED}[pre-commit] ✗${RESET} $*" >&2; exit 1; }

## ── Collect staged Go packages ────────────────────────────────────────────────
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)

if [[ -z "$STAGED_GO_FILES" ]]; then
  ok "No Go files staged – nothing to check."
  exit 0
fi

STAGED_PKGS=$(echo "$STAGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|')

## ── 1. gofmt ─────────────────────────────────────────────────────────────────
step "gofmt check …"
UNFORMATTED=$(gofmt -l $STAGED_GO_FILES)
if [[ -n "$UNFORMATTED" ]]; then
  fail "The following files are not gofmt-formatted:\n${UNFORMATTED}\nRun: go fmt ./..."
fi
ok "gofmt"

## ── 2. go vet ────────────────────────────────────────────────────────────────
step "go vet …"
# shellcheck disable=SC2086
go vet $STAGED_PKGS || fail "go vet reported issues."
ok "go vet"

## ── 3. golangci-lint ─────────────────────────────────────────────────────────
if command -v golangci-lint &>/dev/null; then
  step "golangci-lint …"
  # shellcheck disable=SC2086
  golangci-lint run --config .golangci.yml --new-from-rev HEAD $STAGED_PKGS \
    || fail "golangci-lint reported issues."
  ok "golangci-lint"
else
  step "golangci-lint not found – skipping (run: make install-tools)"
fi

echo -e "${GREEN}[pre-commit] All checks passed.${RESET}"
